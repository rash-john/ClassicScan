    <string name="intro1_title">যেকোনো কিছু\nসেকেন্ডে স্ক্যান</string>
    <string name="intro1_body">ক্যামেরা ধরুন, ClassicScan পৃষ্ঠার কিনারা খুঁজে ছবি সোজা করে ও ছায়া দূর করে। স্বয়ংক্রিয় ছবি চালু করলে পৃষ্ঠা স্থির হলেই ছবি তুলে নেয়।</string>
    <string name="intro2_title">প্রতিটি কাগজের\nজন্য আলাদা মোড</string>
    <string name="intro2_body">আইডি কার্ডের দুই দিক এক পৃষ্ঠায় প্রিন্টের জন্য, বইয়ের দুই পৃষ্ঠা আলাদা, হোয়াইটবোর্ড পরিষ্কার, অথবা QR কোড ও বারকোড পড়ে কাজ করুন।</string>
    <string name="intro3_title">লেখা পড়ে\nদেয় আপনার জন্য</string>
    <string name="intro3_body">প্রতিটি পৃষ্ঠা আপনার ফোনেই পড়া হয়। ভেতরের যেকোনো শব্দ দিয়ে স্ক্যান খুঁজুন, লেখা কপি করুন, খোঁজা-যায় এমন PDF বানান।</string>
    <string name="intro4_title">সাজিয়ে নিন,\nসই করুন</string>
    <string name="intro4_body">ম্যাগনিফায়ার দিয়ে ক্রপ ঠিক করুন, ফিল্টার বাছুন, উজ্জ্বলতা ও কনট্রাস্ট বদলান, পৃষ্ঠায় সই করুন বা দাগ দিন। মূল ছবি সবসময় রাখা থাকে।</string>
    <string name="intro5_title">শুধুই\nআপনার</string>
    <string name="intro5_body">অ্যাকাউন্ট নেই, আপলোড নেই। সবকিছু এই ফোনেই থাকে, আর অ্যাপ লক অন্যদের দূরে রাখে। আপনি শেয়ার করলেই কেবল ফাইল বাইরে যায়।</string>
